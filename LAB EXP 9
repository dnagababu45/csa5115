#include <stdio.h>
#include <string.h>

char matrix[5][5] =
{
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char cipher[] = "KXJEYUREBEZWEHEWRYTUHEYFS";
    char plain[100];

    int i;
    int r1, c1, r2, c2;

    for(i = 0; cipher[i] != '\0'; i += 2)
    {
        findPosition(cipher[i], &r1, &c1);
        findPosition(cipher[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            plain[i] = matrix[r1][(c1 + 4) % 5];
            plain[i + 1] = matrix[r2][(c2 + 4) % 5];
        }
        else if(c1 == c2)
        {
            plain[i] = matrix[(r1 + 4) % 5][c1];
            plain[i + 1] = matrix[(r2 + 4) % 5][c2];
        }
        else
        {
            plain[i] = matrix[r1][c2];
            plain[i + 1] = matrix[r2][c1];
        }
    }

    plain[i] = '\0';

    printf("Ciphertext: %s\n", cipher);
    printf("Plaintext : %s\n", plain);

    return 0;
}
