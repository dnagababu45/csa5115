#include <stdio.h>

int main()
{
    int p[2][2]={{1,0},{0,1}};
    int c[2][2]={{9,4},{5,7}};

    printf("Known Plaintext Matrix:\n");

    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
            printf("%d ",p[i][j]);
        printf("\n");
    }

    printf("Recovered Key Matrix:\n");

    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
            printf("%d ",c[i][j]);
        printf("\n");
    }

    return 0;
}
